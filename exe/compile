#!/usr/bin/env node

"use strict";

const fs = require("fs");
const path = require("path");

const root_dir = path.resolve(__dirname, "..");
const asset_dir = path.join(root_dir, "assets");
const javascript_dir = path.join(asset_dir, "javascripts");
const stylesheet_dir = path.join(asset_dir, "stylesheets");
const javascript_files = [
  "lib/jquery.js",
  "lib/jquery-ui.custom.js",
  "config.js",
  "helper.js",
  "redmine.js",
  "main.js"
];
const stylesheet_files = ["reset.css", "jquery-ui.css", "jquery-ui.override.css", "main.css"];

fs.mkdirSync(javascript_dir, { recursive: true });
fs.mkdirSync(stylesheet_dir, { recursive: true });

fs.writeFileSync(
  path.join(javascript_dir, "main.js"),
  javascript_files.map((file) => fs.readFileSync(path.join(root_dir, "src", "js", file), "utf8")).join("\n") + "\n"
);

fs.writeFileSync(
  path.join(stylesheet_dir, "main.css"),
  stylesheet_files.map((file) => fs.readFileSync(path.join(root_dir, "src", "css", file), "utf8")).join("\n") + "\n"
);

process.stdout.write("compile... finish\n");
